<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>

    <!-- Icono -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Metadatos -->
    <Company>ArdillaDeCirco</Company>
    <Product>Ardilla Updater IA</Product>
    <AssemblyTitle>Ardilla Updater IA</AssemblyTitle>
    <AssemblyName>ArdillaUpdaterIA</AssemblyName>
    <TargetName>ArdillaUpdaterIA</TargetName>
    <Copyright>© 2026 ArdillaDeCirco</Copyright>
    <Description>Instalador y actualizador de contenido para The Sims 4 con Asistente de IA</Description>

    <!-- Versionado:
         NO lo dejes fijo aquÃ­ si vas a versionar por publish con /p:Version=...
         Se dejan valores por defecto "1.1.6" y se sobreescriben al publicar -->
    <Version Condition="'$(Version)'==''">1.1.8</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)'==''">1.1.8.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)'==''">1.1.8.0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)'==''">$(Version)</InformationalVersion>
  </PropertyGroup>

  <!-- ConfiguraciÃ³n para RELEASE -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>RELEASE;TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>

    <!-- Single-file -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeSymbolsInSingleFile>false</IncludeSymbolsInSingleFile>
  </PropertyGroup>

  <!-- ConfiguraciÃ³n para DEBUG -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- Paquetes NuGet -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Sistema de cifrado DPAPI: en net10.0-windows ya viene incluido en el framework,
         por eso no se referencia el paquete System.Security.Cryptography.ProtectedData
         (referenciarlo genera el aviso NU1510). Auditoría interna 2026-10 (Lote C). -->
  </ItemGroup>

  <ItemGroup>
    <None Update="Models.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>


  <!-- Asegura que el diseÃ±ador anide archivos -->
  <ItemGroup>
    <Compile Remove="ArdillaUpdater.Tests\**\*.cs" />

    <Compile Update="Form1.Designer.cs">
      <DependentUpon>Form1.cs</DependentUpon>
    </Compile>

    <EmbeddedResource Update="Form1.resx">
      <DependentUpon>Form1.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>

    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Copiar Models.txt junto al EXE tras publicar -->
  <Target Name="CopyModelsTxtAfterPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Models.txt" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
